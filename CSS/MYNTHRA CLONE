style.css


*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:#fff;
}

header{
display:flex;
justify-content:space-between;
align-items:center;
padding:15px 50px;
background:#fff;
box-shadow:0 2px 10px rgba(0,0,0,.1);
position:sticky;
top:0;
z-index:100;
}

.logo img{
width:60px;
}

nav ul{
display:flex;
list-style:none;
gap:30px;
}

nav ul li a{
text-decoration:none;
color:#282c3f;
font-weight:bold;
font-size:14px;
text-transform:uppercase;
}

.search{
display:flex;
align-items:center;
background:#f5f5f6;
padding:10px;
border-radius:5px;
width:420px;
}

.search input{
border:none;
outline:none;
background:transparent;
margin-left:10px;
width:100%;
}

.icons{
display:flex;
gap:30px;
text-align:center;
font-size:14px;
}

.icons i{
font-size:20px;
margin-bottom:5px;
}

.banner img{
width:100%;
margin-top:20px;
}

.categories{
padding:40px;
}

.categories h2{
margin-bottom:25px;
font-size:28px;
color:#3e4152;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
}

.card{
overflow:hidden;
border-radius:10px;
cursor:pointer;
transition:.3s;
}

.card img{
width:100%;
display:block;
}

.card:hover{
transform:scale(1.05);
}

footer{
background:#282c3f;
color:white;
text-align:center;
padding:20px;
margin-top:50px;
}
